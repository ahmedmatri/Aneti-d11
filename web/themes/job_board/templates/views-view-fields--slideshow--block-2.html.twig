{% set links = fields.field_lien_slider.content|split(';;') %}
<div class="container hero_container" style="background-image: url('{{ file_url(fields.uri.content|striptags|trim) }}')" >
        <div class='hero_content'>
            <div class="slide-caption__title"> {{ fields.title.content }} </div>
            <div class="slide-caption__soustitre"> {{ fields.field_description_slideshow.content }} </div>
            <div class="slide-caption__description"> {{ fields.field_description_slider.content }} </div>
        </div>
</div>
