# Ignore directories generated by Composer
drush/contrib
vendor
web/core
web/modules/contrib
web/modules/intuitiv
web/modules/drupal-fork
web/themes/contrib
web/profiles/contrib
web/libraries
drush/contrib

.claude
specs

# Ignore Drupal's file directory
web/sites/*/files
web/sites/*/files_private
/files_private
web/sites/development.services.yml
web/sites/default/services.local.yml

# Ignore the local phing properties file which includes sensitive informations
phing/build.properties.local

# Ignore sensitive information
.env

# Ignore database-dumps dedicated for rollback
db-dump/*

# OS relevant files
.DS_Store?
.DS_Store

# Ignore temporary files.
*~

# Ignore SimpleTest multi-site environment.
web/sites/simpletest

# IDE: Ignore files generated by PhpStorm
.idea
# IDE: Ignore files generated by Netbeans
nbproject
# IDE: Ignore files generated by VS code
*.code-workspace
.vscode

#local configs
config/environments/excluded/

#Multisite settings
!web/sites/siteTemplate/files

#webserver logs
weblogs/*

