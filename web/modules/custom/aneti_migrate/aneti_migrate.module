<?php

/**
 * @file
 * Contains aneti_migrate.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function aneti_migrate_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the aneti_migrate module.
    case 'help.page.aneti_migrate':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Aneti custom migration') . '</p>';
      return $output;

    default:
  }
}
