/**
 * Implement hook_entity_view()
 */
function aneti_enhance_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode) {
  // Check if cli mode
  if (php_sapi_name() == "cli") {
    return;
  }	
	
  // Prevent non proper roles to access CV.
  $current_user = \Drupal::currentUser();
  $roles = $current_user->getRoles();

  $not_allowed = in_array('anonymous', $roles);

  if ($not_allowed && $entity->bundle() == "curriculum_vitae") {
    //throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
  }
}
