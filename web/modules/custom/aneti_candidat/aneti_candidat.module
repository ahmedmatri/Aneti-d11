<?php
use Drupal\views\Views;
define('ANETI_CANDIDAT_ROLE', 'candidat');
// Load emails functions.
module_load_include('inc', 'aneti_emails', 'includes/emails');

/**
 * Helper function to check if profile is candidat
 *
 * @param Drupal\Core\Entity\EntityInterface $entity
 * @return bool
 */
function aneti_candidat_entity_is_profile_candidat(Drupal\Core\Entity\EntityInterface $entity) {
  $entity_type = $entity->getEntityType()->getBundleEntityType();
  $bundle = $entity->bundle();

  if ($entity_type == 'profile_type' && $bundle == ANETI_CANDIDAT_ROLE) {
    if ($entity->get('field_cin') !== null && $entity->get('field_cin')->getValue()) {
      return TRUE;
    }
  }

  return FALSE;
}
