/**
 * Implement hook_entity_presave().
 */
function aneti_candidat_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if (aneti_candidat_entity_is_profile_candidat($entity)) {
  	
		if($entity->get('field_pays') !== null && $entity->get('field_pays')->getValue() ){
			$pays=$entity->get('field_pays')->getString();
			if($pays=="1343") $entity->field_referant->entity=56798;
			if($pays=="1248") $entity->field_referant->entity=56797;
		}
		if($entity->get('field_pays')->getString()=='1382'){
	    if($entity->get('field_code_postal') !== null && $entity->get('field_code_postal')->getValue() ){
	    	$cdp=$entity->get('field_code_postal')->getString();
	    	
	    	$parent_tid=0;	
	    	$parent_name="";
				$term_name = $cdp;
				$term = \Drupal::entityTypeManager()
				      ->getStorage('taxonomy_term')
				      ->loadByProperties(['name' => $term_name,'vid' => 'codepostal']);		
				
				$term = reset($term);
				if(!empty($term)) $term_id = $term->id();
				if($term_id){
	    		$parent = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadParents($term_id);
	    		$parent = reset($parent);
	    		$parent_tid = $parent->id();
	    		$parent_name= $parent->getName();
	    		if($parent_name) {
						$term_profile = \Drupal::entityTypeManager()
					      ->getStorage('taxonomy_term')
					      ->loadByProperties(['name' => $parent_name,'vid' => 'delegations']);		
						$term_profile = reset($term_profile);
						if(!empty($term_profile)) $term_profile_id = $term_profile->id();   		
		    		if($term_profile_id){
			    		$profiles = \Drupal::entityQuery('profile')
			    				->condition('uid', 1,'>')
			    				->condition('field_delegation_referent', $term_profile_id , 'IN')
			    				->accessCheck(FALSE)
			    				->execute();

							$nb=array();
							foreach($profiles as $key => $value) {
								
								$entity_manager = \Drupal::entityTypeManager();
								$prfl = $entity_manager->getStorage('profile')->load($value);
			    			
			    			$uid=	$prfl->getOwnerId();
								
			    			$candidats = \Drupal::entityQuery('profile')
			    				->condition('type', 'candidat' )
			    				->condition('field_referant', $prfl->getOwnerId() )
			    				->accessCheck(FALSE);
			    				
			    			$nbr= $candidats->count()->execute();
			    			$nb[$uid]=$nbr;
								
							}
							if(!empty($nb)){
								asort($nb);
								foreach($nb as $key => $value){
									$entity->field_referant->entity = $key;
									break;
								}
							}
						}    		
	    		}
				}
				
				
			}	
    }  

  }
}


/**
 * Implement hook_entity_insert().
 */
function aneti_candidat_entity_insert(\Drupal\Core\Entity\EntityInterface $entity) {
  if (aneti_candidat_entity_is_profile_candidat($entity)) {
    // First, we fix the profile owner.
    $uid = $entity->getOwnerId();
    $entity->setOwnerId($uid);
    $user = \Drupal\user\Entity\User::load($uid);

    // Initial creation activate user by default.
    if ($user && !$user->isActive()) {
      // Activate the user and save the user.
      $user->activate();
      $user->addRole(ANETI_CANDIDAT_ROLE);
      $user->save();
      // Publish users's profile by default.
      $entity->set('moderation_state', 'published');
    }
  }
}

