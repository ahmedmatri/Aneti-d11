# Ignore directories generated by Composer
/vendor/

# Ignore Drupal core, contrib modules, themes, libraries managed by Composer
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore Drupal sites files and local configuration
/web/sites/*/files/
/web/sites/*/settings.local.php
/web/sites/*/settings.ddev.php
/web/sites/*/services.local.yml

# Ignore environment files
.env
.env.*
!.env.example

# Ignore database dumps and large archive files
*.sql
*.sql.gz
*.tar.gz

# Ignore DDEV temporary builds
/.ddev/.dbimageBuild/
/.ddev/.webimageBuild/
/.ddev/.ddev-docker-compose*
/.ddev/db_snapshots/

# Ignore OS & IDE metadata
.DS_Store
.idea/
.vscode/
Thumbs.db
/.editorconfig
/.gitattributes