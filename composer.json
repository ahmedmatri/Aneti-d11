{
    "name": "aneti/portal",
    "description": "Portail ANETI (Agence Nationale pour l'Emploi et le Travail Indépendant)",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^1.2",
        "drupal/admin_toolbar": "^3.2",
        "drupal/better_exposed_filters": "^5.2",
        "drupal/block_class": "^2.0",
        "drupal/block_field": "^1.0@RC",
        "drupal/chosen": "^3.0",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_log": "^3.0",
        "drupal/contact_message_rest": "^1.0@alpha",
        "drupal/core-composer-scaffold": "^8.8",
        "drupal/core-project-message": "^8.8",
        "drupal/core-recommended": "^8.8",
        "drupal/core-vendor-hardening": "^8.8",
        "drupal/csv_serialization": "^2.1",
        "drupal/dbug": "^2.0",
        "drupal/devel": "^4.1",
        "drupal/entity": "^1.3",
        "drupal/field_permissions": "^1.0",
        "drupal/file_entity": "^2.0@beta",
        "drupal/flickity": "^3.0@alpha",
        "drupal/getjwtonlogin": "^2.0",
        "drupal/jwt": "^1.0",
        "drupal/leaflet": "^2.2",
        "drupal/node_action_log": "^2.0",
        "drupal/phpspreadsheet": "^2.0",
        "drupal/rest_export_nested": "^1.0",
        "drupal/rest_log": "^2.3",
        "drupal/rest_password": "^8.1",
        "drupal/restui": "^1.21",
        "drupal/search_exclude": "^2.0@beta",
        "drupal/shs": "^2.0@RC",
        "drupal/smtp": "^1.1",
        "drupal/taxonomy_import": "^2.0",
        "drupal/taxonomy_term_depth": "^2.5",
        "drupal/unique_entity_title": "^1.4",
        "drupal/views_send": "^1.6",
        "drupal/we_megamenu": "^1.13",
        "drupal/webform": "^6.1",
        "drupal/webform_remote_handlers": "^2.0",
        "drupal/webform_rest": "^4.0",
        "drush/drush": "^10"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        }
    }
}
