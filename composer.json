{
    "name": "aneti/portal",
    "description": "Portail ANETI (Agence Nationale pour l'Emploi et le Travail Indépendant)",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.2",
        "drupal/better_exposed_filters": "^5.2",
        "drupal/block_class": "^2.0",
        "drupal/block_field": "^1.0@RC",
        "drupal/chosen": "^3.0",
        "drupal/config_log": "^3.0",
        "drupal/config_split": "^2.0",
        "drupal/core-composer-scaffold": "^9.5",
        "drupal/core-project-message": "^9.5",
        "drupal/core-recommended": "^9.5",
        "drupal/csv_serialization": "^2.1",
        "drupal/entity": "^1.3",
        "drupal/faqfield": "^1.1",
        "drupal/field_collection": "3.x-dev",
        "drupal/field_group": "^3.4",
        "drupal/field_permissions": "^1.0",
        "drupal/file_entity": "^2.0@beta",
        "drupal/flickity": "^3.0@alpha",
        "drupal/geofield": "~1.52.0",
        "drupal/geolocation": "^3.0",
        "drupal/getjwtonlogin": "^2.0",
        "drupal/google_analytics": "^4.0",
        "drupal/jwt": "^1.0",
        "drupal/key": "^1.15",
        "drupal/leaflet": "^2.2",
        "drupal/markup": "^1.0",
        "drupal/menu_item_role_access": "^2.0",
        "drupal/metatag": "^1.22",
        "drupal/multiple_registration": "^3.2",
        "drupal/node_revision_delete": "^2.0",
        "drupal/paragraphs": "^1.17",
        "drupal/phpspreadsheet": "^2.0",
        "drupal/profile": "^1.7",
        "drupal/quicktabs": "^3.0@alpha",
        "drupal/rest_export_nested": "^1.0",
        "drupal/rest_password": "^8.1",
        "drupal/restui": "^1.21",
        "drupal/rules": "3.0.0-alpha7",
        "drupal/scheduler": "^1.4",
        "drupal/search_api": "^1.30",
        "drupal/shs": "^2.0@RC",
        "drupal/simplenews": "^2.0@beta",
        "drupal/smtp": "^1.1",
        "drupal/token": "^1.10",
        "drupal/twig_tweak": "^3.1",
        "drupal/vbo_export": "^4.1",
        "drupal/views_bulk_operations": "^4.2",
        "drupal/views_data_export": "^1.2",
        "drupal/views_field_view": "^1.0",
        "drupal/views_send": "^1.6",
        "drupal/we_megamenu": "^1.13",
        "drupal/webform": "^6.2",
        "drupal/webform_remote_handlers": "^2.0",
        "drupal/webform_rest": "^4.0",
        "drush/drush": "^10",
        "vlucas/phpdotenv": "^5.5"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true
        }
    },
    "extra": {
        "enable-patching": true,
        "patches": {
            "drupal/multiple_registration": {
                "Fix unindexed cartesian join on update 8204": "patches/multiple_registration-fix-update-8204.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        }
    },
    "require-dev": {
        "drupal/devel": "^5.1"
    }
}
